{
  "name": "flaviano-dlucca-salon",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "preview": "serve out -l 3000 --no-clipboard",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "images": "node scripts/generate-images.mjs",
    "snapshot:services": "node scripts/snapshot-square.mjs --write",
    "verify:services": "node scripts/snapshot-square.mjs --verify"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "framer-motion": "13.1.0",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.23",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.6",
    "serve": "^14.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
